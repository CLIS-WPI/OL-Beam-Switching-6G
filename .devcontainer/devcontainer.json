{
    "name": "TensorFlow NGC (Sionna)",
    // Your Docker image
    "image": "nvcr.io/nvidia/tensorflow:24.04-tf2-py3",

    // Runtime options for Docker
    "runArgs": [
        "--gpus=all",
        "--shm-size=1g",
        "--ulimit=memlock=-1"
        // Do not set --user here; let VS Code manage it or use the default
    ],

    // Project folder mount
    // ${localWorkspaceFolder} refers to your project folder
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind,consistency=cached"
    ],
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",

    // The user VS Code should use inside the container
    // You can remove this line to use the container default (probably root)
    // Or specify a particular user if present in the image (like 'nvidia' or 'tf')
    "remoteUser": "root",

    // (Optional) Commands to run after container creation
    "postCreateCommand": "pip install --no-cache-dir sionna torch matplotlib scipy pandas"

    // Other settings ...
}